{
  "name": "aura-battle",
  "private": true,
  "version": "1.0.0",
  "description": "Battle d'aura 1v1 jugée par une IA on-device : la caméra détecte tes moves, le juge distribue les points. 30 secondes, le plus d'aura gagne.",
  "license": "GPL-3.0-only",
  "author": "Mattéo Pollet",
  "repository": {
    "type": "git",
    "url": "https://github.com/matteopollet/aurabattle.git"
  },
  "keywords": ["game", "camera", "mediapipe", "webrtc", "peerjs", "aura"],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:mobile": "AURA_SSL=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "postinstall": "node scripts/setup-assets.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "peerjs": "^1.5.4"
  }
}
